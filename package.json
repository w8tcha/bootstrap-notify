{
  "name": "@w8tcha/bootstrap-notify",
  "version": "5.0.2",
  "description": "This is a simple plugin that turns standard Bootstrap toats into \"Growl-like\" notifications.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git://github.com/w8tcha/bootstrap-notify.git"
  },
  "keywords": [
    "bootstrap",
    "notify",
    "notification",
    "notifications",
    "growl",
    "message",
    "toast"
  ],
  "author": "Ingo Herbote",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/w8tcha/bootstrap-notify/issues"
  },
  "homepage": "https://w8tcha.github.io/bootstrap-notify/",
  "main": ".dist/bootstrap-notify.js",
  "types": "./dist/bootstrap-notify.d.ts",
  "exports": {
    "import": "./dist/bootstrap-notify.js",
    "require": "./dist/bootstrap-notify.umd.cjs"
  },
  "browserslist": [ "last 2 versions" ],
  "peerDependencies": {
    "bootstrap": "^5.3"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
